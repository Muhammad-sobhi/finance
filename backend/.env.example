APP_NAME=Dinar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Data master key (encrypts every user's data key). Production: a root-owned file outside the
# project and the backups. Local: DATA_MASTER_KEY=base64:... from `php artisan vault:key`.
DATA_MASTER_KEY_FILE=
DATA_MASTER_KEY=
DATA_MASTER_KEY_PREVIOUS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL in production. For a quick local run you may use DB_CONNECTION=sqlite instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance
DB_USERNAME=finance
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web push (browser notifications). Generate with: php artisan webpush:vapid
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Where links in alert emails/pushes point (the SPA). Defaults to APP_URL.
FRONTEND_URL=http://localhost:5173

# Login tokens expire after this many minutes (default 30 days).
SANCTUM_EXPIRATION=43200

# Free, keyless price feeds (override only if you use another provider).
# RATES_URL=https://open.er-api.com/v6/latest/{base}
# METALS_URL=https://api.gold-api.com/price/{symbol}

# Nightly encrypted backup of the database + receipts (php artisan finance:backup, 03:15).
# Off until BACKUP_KEY is set: php artisan finance:backup-key. Keep a copy of the key off the server.
BACKUP_KEY=
BACKUP_KEEP_DAYS=30
# local = storage/app/backups (same server!). s3 = any S3-compatible bucket, e.g. Backblaze B2 or Cloudflare R2.
BACKUP_DRIVER=local
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=dinar
# BACKUP_MYSQLDUMP=mariadb-dump

# Monitoring: admins get an email when the queue, backup or encryption key stops working; this address too.
OPS_ALERT_EMAIL=
# Error reports to Sentry (free plan is enough). Empty = off. No request bodies or user data are sent.
SENTRY_LARAVEL_DSN=
